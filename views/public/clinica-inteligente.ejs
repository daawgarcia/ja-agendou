<script>
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', () => {
    const item = q.parentElement;
    const wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
    if (!wasOpen) item.classList.add('open');
  });
});

let checkoutClicked = false;

function readCookie(name) {
  const match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
  return match ? decodeURIComponent(match[1]) : null;
}

document.querySelectorAll('a[data-checkout-source]').forEach(link => {
  link.addEventListener('click', () => {
    const source = link.getAttribute('data-checkout-source') || 'checkout_unknown';
    const value =     Number(link.getAttribute('data-checkout-value')) || 197;
    checkoutClicked = true;
    const payload = {
          content_name: 'Clínica Inteligente',
      value,
      currency: 'BRL',
      source,
    };

    if (typeof window.fbq === 'function') {
      window.fbq('track', 'InitiateCheckout', payload);
    }

    try {
      const beaconPayload = JSON.stringify({
        fbp: readCookie('_fbp'),
        fbc: readCookie('_fbc'),
        source,
        value,
        contentName: 'Clínica Inteligente',
        eventSourceUrl: window.location.href,
      });
      const blob = new Blob([beaconPayload], { type: 'application/json' });
      if (navigator.sendBeacon) {
        navigator.sendBeacon('/api/track/checkout-click', blob);
      } else {
        fetch('/api/track/checkout-click', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: beaconPayload, keepalive: true });
      }
    } catch (e) {
      // silencioso — não deve bloquear o checkout
    }

    if (typeof window.gtag === 'function') {
      window.gtag('event', 'begin_checkout', {
        currency: 'BRL',
        value,
        items: [{ item_name: 'Clínica Inteligente', price: value, quantity: 1 }],
        source,
      });
    }

    if (Array.isArray(window.dataLayer)) {
      window.dataLayer.push({
        event: 'checkout_click',
        source,
        value,
        currency: 'BRL',
        product: 'clinica_inteligente',
      });
    }

    if (window.posthog) {
      window.posthog.capture('checkout_click', { source, value, currency: 'BRL', product: 'clinica_inteligente' });
    }
  });
});

// Seções vistas (PostHog): mostra até onde o visitante chega antes de sair
if (window.posthog && 'IntersectionObserver' in window) {
  const sections = Array.from(document.querySelectorAll('body > section, body > footer'));
  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      sectionObserver.unobserve(entry.target);
      window.posthog.capture('section_viewed', {
        section: entry.target.classList[0] || entry.target.tagName.toLowerCase(),
        position: sections.indexOf(entry.target) + 1,
        total_sections: sections.length,
        product: 'clinica_inteligente',
      });
    });
  }, { rootMargin: '0px 0px -50% 0px' });
  sections.forEach((s) => sectionObserver.observe(s));
}

// Barra fixa mobile: aparece quando nem o hero nem a oferta estão visíveis
(function () {
  const bar = document.getElementById('stickyCta');
  const targets = [document.querySelector('.hero .btn-primary'), document.getElementById('comprar')].filter(Boolean);
  if (!bar || !('IntersectionObserver' in window)) return;
  const visible = new Set();
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { e.isIntersecting ? visible.add(e.target) : visible.delete(e.target); });
    bar.classList.toggle('show', visible.size === 0 && window.scrollY > 200);
  });
  targets.forEach((t) => io.observe(t));
})();

// ── Pop-up de saída: uma vez por visitante, nunca para quem já clicou em comprar ──
(function () {
  const STORAGE_KEY = 'clinica_exit_popup_shown';
  const ELIGIBLE_AFTER_MS = 8000;
  const IDLE_TRIGGER_MS = 60000;
  const COUPON_DURATION_S = 15 * 60;

  const overlay = document.getElementById('exitPopup');
  const card = document.getElementById('exitCard');
  const countdownEl = document.getElementById('exitCountdown');
  if (!overlay) return;

  const loadedAt = Date.now();
  let shown = false;
  let backTrapArmed = false;
  let countdownTimer = null;

  function alreadyShown() {
    try { return !!localStorage.getItem(STORAGE_KEY); } catch (e) { return false; }
  }

  function canShow() {
    return !shown && !checkoutClicked && !alreadyShown() && Date.now() - loadedAt >= ELIGIBLE_AFTER_MS;
  }

  function startCountdown() {
    let remaining = COUPON_DURATION_S;
    const render = () => {
      const m = String(Math.floor(remaining / 60)).padStart(2, '0');
      const s = String(remaining % 60).padStart(2, '0');
      countdownEl.textContent = m + ':' + s;
    };
    render();
    countdownTimer = setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        clearInterval(countdownTimer);
        card.classList.add('expired');
        return;
      }
      render();
    }, 1000);
  }

  function show(trigger) {
    if (!canShow()) return false;
    shown = true;
    try { localStorage.setItem(STORAGE_KEY, String(Date.now())); } catch (e) { /* modo privado */ }

    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => overlay.classList.add('visible'));
    startCountdown();
    const cta = overlay.querySelector('.exit-cta');
    if (cta) cta.focus({ preventScroll: true });

    if (typeof window.fbq === 'function') window.fbq('trackCustom', 'ExitPopupShown', { trigger });
    if (typeof window.gtag === 'function') window.gtag('event', 'exit_popup_shown', { trigger });
    if (window.posthog) window.posthog.capture('exit_popup_shown', { trigger, product: 'clinica_inteligente' });
    return true;
  }

  function hide() {
    overlay.classList.remove('visible');
    overlay.setAttribute('aria-hidden', 'true');
    setTimeout(() => overlay.classList.remove('open'), 250);
  }

  document.getElementById('exitClose').addEventListener('click', hide);
  document.getElementById('exitDismiss').addEventListener('click', hide);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) hide(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && overlay.classList.contains('open')) hide(); });
  overlay.querySelector('.exit-cta').addEventListener('click', () => setTimeout(hide, 300));

  // Desktop: mouse saindo pelo topo da janela
  document.addEventListener('mouseout', (e) => {
    if (!e.relatedTarget && e.clientY <= 0) show('mouse_exit');
  });

  // Celular: botão voltar (do aparelho ou do navegador do Instagram).
  // O navegador ignora entradas de histórico criadas sem interação, por isso só arma após o primeiro toque/rolagem.
  function armBackTrap() {
    if (backTrapArmed || alreadyShown()) return;
    backTrapArmed = true;
    history.pushState({ exitTrap: true }, '', location.href);
  }
  ['touchstart', 'scroll', 'click'].forEach((evt) =>
    window.addEventListener(evt, armBackTrap, { once: true, passive: true })
  );
  window.addEventListener('popstate', () => {
    if (!backTrapArmed) return;
    backTrapArmed = false;
    if (!show('back_button')) history.back();
  });

  // Celular: rolagem rápida para cima (gesto de quem desistiu)
  let lastY = window.scrollY;
  let lastT = Date.now();
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    const t = Date.now();
    const dt = t - lastT;
    if (dt > 0 && dt < 300 && lastY - y > 450 && y > 200) show('fast_scroll_up');
    if (dt >= 120) { lastY = y; lastT = t; }
  }, { passive: true });

  // Saiu para outro app/aba e voltou
  let hiddenAt = null;
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { hiddenAt = Date.now(); return; }
    if (hiddenAt && Date.now() - hiddenAt >= 4000) show('returned_to_tab');
    hiddenAt = null;
  });

  // Tempo na página sem clicar em comprar
  setTimeout(() => show('idle_60s'), IDLE_TRIGGER_MS);
})();
</script>

</body>
</html>

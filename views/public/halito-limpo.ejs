    <p><a href="/politica-privacidade">Política de privacidade</a> · <a href="/termos-de-uso">Termos de uso</a></p>
  </div>
</footer>

<div class="sticky" id="sticky">
  <a href="<%= cta('sticky_cta') %>" class="btn btn-full" <%- ext %> data-checkout-source="sticky_cta">Quero o método · R$ <%= PRICE %></a>
</div>

<script>
(function () {
  var PRODUCT = 'halito_limpo';
  var CONTENT_NAME = 'Ebook Hálito Limpo em 7 Dias';
  var VALUE = <%= PRICE_NUM %>;
  var HAS_CHECKOUT = <%= hasCheckout ? 'true' : 'false' %>;

  document.querySelectorAll('.faq-q').forEach(function (q) {
    q.addEventListener('click', function () {
      var item = q.parentElement;
      var wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(function (i) { i.classList.remove('open'); });
      if (!wasOpen) item.classList.add('open');
    });
  });

  var sticky = document.getElementById('sticky');
  var hero = document.querySelector('.hero');
  var offer = document.getElementById('oferta');
  if ('IntersectionObserver' in window && sticky) {
    var heroGone = false, offerVisible = false;
    var update = function () { sticky.classList.toggle('show', heroGone && !offerVisible); };
    new IntersectionObserver(function (e) { heroGone = !e[0].isIntersecting; update(); }).observe(hero);
    new IntersectionObserver(function (e) { offerVisible = e[0].isIntersecting; update(); }).observe(offer);
  }

  // ViewContent: ajuda o Meta a otimizar para quem chega na página de vendas
  if (typeof window.fbq === 'function') {
    window.fbq('track', 'ViewContent', { content_name: CONTENT_NAME, content_type: 'product', value: VALUE, currency: 'BRL' });
  }

  // Leva a origem do anúncio para o checkout: aparece nos relatórios da Hotmart como src/sck
  if (HAS_CHECKOUT) {
    var qs = new URLSearchParams(window.location.search);
    var src = (qs.get('utm_source') || qs.get('src') || (document.referrer ? 'referral' : 'direto')).slice(0, 30);
    var sck = [qs.get('utm_campaign'), qs.get('utm_content')].filter(Boolean).join('|').slice(0, 60);
    document.querySelectorAll('a[data-checkout-source]').forEach(function (a) {
      try {
        var u = new URL(a.href);
        u.searchParams.set('src', src);
        if (sck) u.searchParams.set('sck', sck);
        a.href = u.toString();
      } catch (e) {}
    });
  }

  function readCookie(name) {
    var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
    return m ? decodeURIComponent(m[1]) : null;
  }

  document.querySelectorAll('a[data-checkout-source]').forEach(function (link) {
    link.addEventListener('click', function () {
      if (!HAS_CHECKOUT) return;
      var source = link.getAttribute('data-checkout-source') || 'checkout_unknown';
      var payload = { content_name: CONTENT_NAME, value: VALUE, currency: 'BRL', source: source };
      if (typeof window.fbq === 'function') window.fbq('track', 'InitiateCheckout', payload);
      try {
        var body = JSON.stringify({ fbp: readCookie('_fbp'), fbc: readCookie('_fbc'), source: source, value: VALUE, contentName: CONTENT_NAME, eventSourceUrl: window.location.href });
        if (navigator.sendBeacon) navigator.sendBeacon('/api/track/checkout-click', new Blob([body], { type: 'application/json' }));
        else fetch('/api/track/checkout-click', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body, keepalive: true });
      } catch (e) {}
      if (typeof window.gtag === 'function') window.gtag('event', 'begin_checkout', { currency: 'BRL', value: VALUE, items: [{ item_name: CONTENT_NAME, price: VALUE, quantity: 1 }], source: source });
      if (window.posthog) window.posthog.capture('checkout_click', { source: source, value: VALUE, currency: 'BRL', product: PRODUCT });
    });
  });

  if (window.posthog && 'IntersectionObserver' in window) {
    var sections = Array.prototype.slice.call(document.querySelectorAll('body > section, body > footer'));
    var so = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        so.unobserve(entry.target);
        window.posthog.capture('section_viewed', { section: entry.target.classList[0] || entry.target.id || entry.target.tagName.toLowerCase(), position: sections.indexOf(entry.target) + 1, total_sections: sections.length, product: PRODUCT });
      });
    }, { rootMargin: '0px 0px -50% 0px' });
    sections.forEach(function (s) { so.observe(s); });
  }
})();
</script>
</body>
</html>

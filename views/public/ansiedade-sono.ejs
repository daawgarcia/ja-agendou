.garantia-icon { font-size: 100px; line-height: 1; flex-shrink: 0; }
.garantia-text p { color: var(--gray); font-size: 16px; line-height: 1.8; margin-bottom: 20px; }
.garantia-badge { display: inline-block; background: rgba(139,92,246,0.1); border: 2px solid var(--accent); border-radius: 12px; padding: 12px 28px; color: var(--accent2); font-weight: 800; font-size: 15px; }

/* ── FAQ ── */
.faq { background: var(--navy); padding: 88px 24px; }
.faq-inner { max-width: 820px; margin: 0 auto; }
.faq-list { margin-top: 40px; }
.faq-item { background: rgba(255,255,255,0.03); border: 1px solid rgba(139,92,246,0.12); border-radius: 12px; margin-bottom: 10px; overflow: hidden; }
.faq-q { padding: 20px 22px; font-weight: 700; color: #fff; font-size: 15px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; user-select: none; }
.faq-q::after { content: '+'; font-size: 22px; color: var(--accent2); flex-shrink: 0; }
.faq-item.open .faq-q::after { content: '−'; }
.faq-a { display: none; padding: 0 22px 20px; color: var(--gray); font-size: 14px; line-height: 1.8; }
.faq-item.open .faq-a { display: block; }

/* ── CTA FINAL ── */
.cta-final { background: linear-gradient(135deg, #0d0a1a 0%, #130d2a 100%); padding: 88px 24px; text-align: center; }

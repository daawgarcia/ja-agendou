.nav-cta { background: var(--accent); color: #fff; font-size: 13px; font-weight: 800; padding: 8px 22px; border-radius: 30px; text-decoration: none; transition: opacity 0.2s; }
.nav-cta:hover { opacity: 0.85; }

/* ── HERO ── */
.hero {

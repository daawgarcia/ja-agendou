.paraquem-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 48px; text-align: left; }
.pq-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(139,92,246,0.15); border-radius: 16px; padding: 28px 24px; display: flex; gap: 16px; align-items: flex-start; transition: border-color 0.2s, background 0.2s; }
.pq-card:hover { border-color: rgba(139,92,246,0.4); background: rgba(255,255,255,0.07); }
.pq-icon { font-size: 28px; flex-shrink: 0; }
.pq-card h3 { color: #fff; font-size: 15px; font-weight: 700; margin-bottom: 6px; line-height: 1.3; }
.pq-card p { color: var(--gray); font-size: 13px; line-height: 1.6; }

/* ── CONTEÚDO ── */
.conteudo { background: var(--navy); padding: 88px 24px; }
.conteudo-inner { max-width: 1100px; margin: 0 auto; }
.conteudo-header { text-align: center; margin-bottom: 56px; }
.sec-text { color: var(--gray); font-size: 16px; line-height: 1.8; margin-bottom: 24px; max-width: 640px; margin-left: auto; margin-right: auto; }
.conteudo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
.cont-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(139,92,246,0.12); border-radius: 16px; padding: 28px 24px; transition: border-color 0.2s, background 0.2s; }
.cont-card:hover { border-color: rgba(139,92,246,0.35); background: rgba(255,255,255,0.06); }
.cont-num { color: var(--accent2); font-size: 10px; font-weight: 900; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 10px; }
.cont-card h3 { color: #fff; font-size: 16px; font-weight: 800; margin-bottom: 8px; line-height: 1.3; }
.cont-card p { color: var(--gray); font-size: 13px; line-height: 1.7; }

/* ── PLANO 14 DIAS ── */
.plano { background: linear-gradient(135deg, rgba(139,92,246,0.06) 0%, rgba(74,158,255,0.03) 100%); border-top: 1px solid rgba(139,92,246,0.15); border-bottom: 1px solid rgba(139,92,246,0.15); padding: 88px 24px; }
.plano-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
.plano-content { }
.plano-steps { list-style: none; margin-top: 32px; display: flex; flex-direction: column; gap: 20px; }
.plano-step { display: flex; gap: 18px; align-items: flex-start; }
.step-badge { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 14px; color: #fff; flex-shrink: 0; }
.step-info h4 { color: #fff; font-size: 15px; font-weight: 700; margin-bottom: 4px; }
.step-info p { color: var(--gray); font-size: 13px; line-height: 1.6; }
.plano-visual { display: flex; justify-content: center; }
.plano-card { background: rgba(139,92,246,0.08); border: 2px solid rgba(139,92,246,0.3); border-radius: 24px; padding: 40px 32px; text-align: center; max-width: 340px; width: 100%; }
.plano-card-num { font-size: 80px; font-weight: 900; line-height: 1; color: var(--accent2); opacity: 0.9; }
.plano-card-label { color: #fff; font-size: 22px; font-weight: 800; margin-bottom: 16px; }
.plano-card-desc { color: var(--gray); font-size: 14px; line-height: 1.7; }
.plano-card-pills { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 20px; }
.plano-pill { background: rgba(139,92,246,0.15); border: 1px solid rgba(139,92,246,0.3); color: var(--accent2); font-size: 11px; font-weight: 700; padding: 4px 12px; border-radius: 20px; }

/* ── BÔNUS ── */
.bonus { background: var(--navy2); padding: 88px 24px; }
.bonus-inner { max-width: 1100px; margin: 0 auto; text-align: center; }
.bonus-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 48px; text-align: left; }
.bonus-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(201,168,76,0.2); border-radius: 16px; padding: 28px 24px; position: relative; overflow: hidden; }
.bonus-card::before { content: 'BÔNUS'; position: absolute; top: 12px; right: -10px; background: var(--ouro); color: var(--navy); font-size: 9px; font-weight: 900; letter-spacing: 1px; padding: 3px 20px; transform: rotate(35deg); }
.bonus-icon { font-size: 32px; margin-bottom: 14px; }

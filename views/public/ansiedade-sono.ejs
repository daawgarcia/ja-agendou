  background: radial-gradient(ellipse 70% 60% at 70% 50%, rgba(139,92,246,0.09) 0%, transparent 70%);
  pointer-events: none;
}
.hero-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; position: relative; z-index: 1; }
.hero-tag { display: inline-flex; align-items: center; gap: 8px; background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.35); color: var(--accent2); font-size: 11px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; padding: 6px 16px; border-radius: 30px; margin-bottom: 24px; }
.hero h1 { font-size: clamp(30px, 4.5vw, 50px); font-weight: 900; color: #fff; line-height: 1.1; margin-bottom: 18px; }
.hero h1 em { color: var(--accent2); font-style: normal; }
.hero-sub { font-size: clamp(15px, 2vw, 18px); color: var(--gray); line-height: 1.7; margin-bottom: 32px; max-width: 480px; }
.hero-bullets { list-style: none; margin-bottom: 36px; display: flex; flex-direction: column; gap: 12px; }
.hero-bullets li { display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,0.9); font-size: 15px; font-weight: 600; }
.bullet-icon { width: 20px; height: 20px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0; }
.btn-primary {
  display: inline-block;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
  color: #fff;
  font-size: clamp(16px, 2vw, 19px);
  font-weight: 900;
  padding: 18px 48px;
  border-radius: 50px;
  text-decoration: none;
  box-shadow: 0 8px 40px rgba(139,92,246,0.4);
  transition: transform 0.15s, box-shadow 0.15s;
  cursor: pointer;
}
.btn-primary:hover { transform: translateY(-3px); box-shadow: 0 12px 50px rgba(139,92,246,0.55); }
.hero-micro { color: var(--gray); font-size: 12px; margin-top: 14px; display: flex; align-items: center; gap: 6px; }
.hero-micro strong { color: rgba(255,255,255,0.7); }
.hero-img-wrap { display: flex; justify-content: center; align-items: center; }
.hero-img-wrap img { width: 100%; max-width: 460px; border-radius: 16px; filter: drop-shadow(0 20px 60px rgba(0,0,0,0.6)); }

/* ── URGÊNCIA ── */
.urgencia { background: linear-gradient(135deg, #0d0a1a 0%, #130d2a 100%); padding: 72px 24px; text-align: center; border-top: 1px solid rgba(139,92,246,0.12); border-bottom: 1px solid rgba(139,92,246,0.12); }
.urgencia-inner { max-width: 860px; margin: 0 auto; }
.urgencia h2 { font-size: clamp(28px, 4vw, 44px); font-weight: 900; color: #fff; margin-bottom: 20px; }
.urgencia h2 em { color: var(--accent2); font-style: normal; }
.urgencia p { color: var(--gray); font-size: 17px; line-height: 1.8; margin-bottom: 40px; max-width: 700px; margin-left: auto; margin-right: auto; }
.sintomas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; text-align: left; }
.sintoma-card { background: rgba(139,92,246,0.07); border: 1px solid rgba(139,92,246,0.2); border-radius: 14px; padding: 20px 18px; display: flex; gap: 12px; align-items: flex-start; }
.sintoma-icon { font-size: 22px; flex-shrink: 0; }
.sintoma-card p { color: rgba(255,255,255,0.85); font-size: 14px; font-weight: 600; line-height: 1.4; margin: 0; }

/* ── PARA QUEM ── */
.paraquem { background: var(--navy2); padding: 88px 24px; }
.paraquem-inner { max-width: 1100px; margin: 0 auto; text-align: center; }
.sec-tag { display: inline-block; color: var(--accent2); font-size: 11px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 12px; }
.sec-tag.gold { color: var(--ouro2); }
h2 { font-size: clamp(24px, 3.5vw, 38px); color: #fff; font-weight: 900; line-height: 1.2; margin-bottom: 20px; }
h2 em { color: var(--accent2); font-style: normal; }

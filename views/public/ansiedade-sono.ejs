  --navy2: #0d1a2e;
  --navy3: #132238;
  --accent: #8B5CF6;
  --accent2: #A78BFA;
  --ouro: #c9a84c;
  --ouro2: #e8c97a;
  --green: #2ecc71;
  --red: #e74c3c;
  --white: #ffffff;
  --gray: #8a9bb0;
  --text: #bdd0e4;
}
html { scroll-behavior: smooth; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--text); background: var(--navy); line-height: 1.6; overflow-x: hidden; }

/* ── TOP BAR ── */
.top-bar {
  background: linear-gradient(90deg, #0d1a2e 0%, #1a0f2e 100%);
  border-bottom: 2px solid var(--accent);
  color: #fff;
  text-align: center;
  padding: 10px 20px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.3px;
}
.top-bar em { color: var(--accent2); font-style: normal; }

/* ── NAV ── */
nav { background: rgba(7,16,30,0.95); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(139,92,246,0.15); position: sticky; top: 0; z-index: 100; }
.nav-inner { max-width: 1100px; margin: 0 auto; padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; }
.nav-logo { color: #fff; font-size: 15px; font-weight: 800; text-decoration: none; }

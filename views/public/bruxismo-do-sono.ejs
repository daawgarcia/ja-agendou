<script>
(function () {
  var PRODUCT = 'ebook_bruxismo';
  var CONTENT_NAME = 'Ebook Bruxismo do Sono';
  var VALUE = <%= PRICE_NUM %>;
  var HAS_CHECKOUT = <%= hasCheckout ? 'true' : 'false' %>;
  var checkoutClicked = false;

  document.querySelectorAll('.faq-q').forEach(function (q) {
    q.addEventListener('click', function () {
      var item = q.parentElement, wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(function (i) { i.classList.remove('open'); });
      if (!wasOpen) item.classList.add('open');
    });
  });

  // CTA fixo no celular: aparece depois do hero e some quando a oferta está na tela
  var sticky = document.getElementById('sticky'), hero = document.querySelector('.hero'), offer = document.getElementById('comprar');
  if ('IntersectionObserver' in window && sticky) {
    var heroGone = false, offerVisible = false;
    var upd = function () { sticky.classList.toggle('show', heroGone && !offerVisible); };
    new IntersectionObserver(function (e) { heroGone = !e[0].isIntersecting; upd(); }).observe(hero);
    new IntersectionObserver(function (e) { offerVisible = e[0].isIntersecting; upd(); }).observe(offer);
  }

  if (typeof window.fbq === 'function') window.fbq('track', 'ViewContent', { content_name: CONTENT_NAME, content_type: 'product', value: VALUE, currency: 'BRL' });

  // Leva a origem do anúncio para o checkout (src/sck nos relatórios da Hotmart)
  if (HAS_CHECKOUT) {
    var qs = new URLSearchParams(location.search);
    var src = (qs.get('utm_source') || qs.get('src') || (document.referrer ? 'referral' : 'direto')).slice(0, 30);
    var sck = [qs.get('utm_campaign'), qs.get('utm_content')].filter(Boolean).join('|').slice(0, 60);
    document.querySelectorAll('a[data-checkout-source]').forEach(function (a) {
      try { var u = new URL(a.href); u.searchParams.set('src', src); if (sck) u.searchParams.set('sck', sck); a.href = u.toString(); } catch (e) {}
    });
  }

  function readCookie(n) { var m = document.cookie.match(new RegExp('(?:^|; )' + n + '=([^;]*)')); return m ? decodeURIComponent(m[1]) : null; }

  document.querySelectorAll('a[data-checkout-source]').forEach(function (link) {
    link.addEventListener('click', function () {
      if (!HAS_CHECKOUT) return;
      checkoutClicked = true;
      var source = link.getAttribute('data-checkout-source') || 'checkout_unknown';
      var value = Number(link.getAttribute('data-checkout-value')) || VALUE;
      if (typeof window.fbq === 'function') window.fbq('track', 'InitiateCheckout', { content_name: CONTENT_NAME, value: value, currency: 'BRL', source: source });
      try {
        var body = JSON.stringify({ fbp: readCookie('_fbp'), fbc: readCookie('_fbc'), source: source, value: value, contentName: CONTENT_NAME, eventSourceUrl: location.href });
        if (navigator.sendBeacon) navigator.sendBeacon('/api/track/checkout-click', new Blob([body], { type: 'application/json' }));
        else fetch('/api/track/checkout-click', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body, keepalive: true });
      } catch (e) {}
      if (typeof window.gtag === 'function') window.gtag('event', 'begin_checkout', { currency: 'BRL', value: value, items: [{ item_name: CONTENT_NAME, price: value, quantity: 1 }], source: source });
      if (window.posthog) window.posthog.capture('checkout_click', { source: source, value: value, currency: 'BRL', product: PRODUCT });
    });
  });

  if (window.posthog && 'IntersectionObserver' in window) {
    var secs = Array.prototype.slice.call(document.querySelectorAll('body > section, body > .proof, body > footer'));
    var so = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        so.unobserve(en.target);
        window.posthog.capture('section_viewed', { section: en.target.classList[0] || en.target.tagName.toLowerCase(), position: secs.indexOf(en.target) + 1, total_sections: secs.length, product: PRODUCT });
      });
    }, { rootMargin: '0px 0px -50% 0px' });
    secs.forEach(function (s) { so.observe(s); });
  }

  // Pop-up de saída: SÓ por intenção real de sair (sem gatilho por tempo ocioso)
  var overlay = document.getElementById('exitPopup');
  if (!overlay) return;
  var KEY = 'bruxismo_exit_popup_shown', shown = false, maxScroll = 0, backArmed = false;
  function seen() { try { return !!localStorage.getItem(KEY); } catch (e) { return false; } }
  function engaged() { return maxScroll >= 0.2; } // leu pelo menos 20% da página
  window.addEventListener('scroll', function () {
    var h = document.documentElement.scrollHeight - innerHeight;
    if (h > 0) maxScroll = Math.max(maxScroll, scrollY / h);
  }, { passive: true });
  function show(trigger) {
    if (shown || checkoutClicked || seen()) return false;
    shown = true;
    try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
    overlay.classList.add('open'); overlay.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(function () { overlay.classList.add('visible'); });
    if (typeof window.fbq === 'function') window.fbq('trackCustom', 'ExitPopupShown', { trigger: trigger });
    if (window.posthog) window.posthog.capture('exit_popup_shown', { trigger: trigger, product: PRODUCT, max_scroll: Math.round(maxScroll * 100) });
    return true;
  }
  function hide() { overlay.classList.remove('visible'); overlay.setAttribute('aria-hidden', 'true'); setTimeout(function () { overlay.classList.remove('open'); }, 250); }
  document.getElementById('exitClose').addEventListener('click', hide);
  document.getElementById('exitDismiss').addEventListener('click', hide);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) hide(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });

  // Desktop: mouse saindo pelo topo
  document.addEventListener('mouseout', function (e) { if (!e.relatedTarget && e.clientY <= 0 && engaged()) show('mouse_exit'); });
  // Celular: botão voltar
  function arm() { if (backArmed || seen()) return; backArmed = true; history.pushState({ exitTrap: true }, '', location.href); }
  ['touchstart', 'scroll', 'click'].forEach(function (ev) { window.addEventListener(ev, arm, { once: true, passive: true }); });
  window.addEventListener('popstate', function () { if (!backArmed) return; backArmed = false; if (!(engaged() && show('back_button'))) history.back(); });
  // Celular: rolagem rápida para cima, só depois de ter lido parte da página
  var lastY = scrollY, lastT = Date.now();
  window.addEventListener('scroll', function () {
    var y = scrollY, t = Date.now(), dt = t - lastT;
    if (dt > 0 && dt < 300 && lastY - y > 450 && y > 200 && engaged()) show('fast_scroll_up');
    if (dt >= 120) { lastY = y; lastT = t; }
  }, { passive: true });
  // Voltou para a aba depois de sair
  var hiddenAt = null;
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { hiddenAt = Date.now(); return; }
    if (hiddenAt && Date.now() - hiddenAt >= 4000 && engaged()) show('returned_to_tab');
    hiddenAt = null;
  });
})();
</script>
</body>

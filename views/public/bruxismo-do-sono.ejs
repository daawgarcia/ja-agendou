      <a href="<%= cta('hero_cta') %>" class="btn" <%- ext %> data-checkout-source="hero_cta">Quero o protocolo completo →</a>
      <div class="hero-price">R$ <strong><%= PRICE %></strong> ou em até 12x · 7 dias de garantia</div>
      <div class="micro">🔒 <b>Compra segura via Hotmart</b> · Pix, cartão ou boleto</div>
    </div>
    <div class="hero-img">
      <img src="/images/ebook-bruxismo/mockup.webp" alt="Ebook Bruxismo do Sono com as fichas clínicas" width="600" height="600" loading="eager">
    </div>
  </div>
</section>

<!-- Faixa de prova logo abaixo do hero: encurta a ponte até o "problema" -->
<div class="proof">
  <div class="wrap proof-grid">
    <div class="proof-item"><b>14</b><span>capítulos, do consenso à reabilitação</span></div>
    <div class="proof-item"><b>6</b><span>fichas clínicas prontas para imprimir</span></div>

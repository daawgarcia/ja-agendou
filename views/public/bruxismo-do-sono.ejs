<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bruxismo do Sono: Protocolo Clínico Completo para Dentistas</title>
<meta name="description" content="O protocolo de consultório para diagnosticar, proteger e acompanhar o paciente com bruxismo do sono. Do consenso internacional à placa oclusal, com 6 fichas clínicas para imprimir.">
<meta property="og:title" content="Bruxismo do Sono: Protocolo Clínico Completo">
<meta property="og:description" content="Do consenso à placa oclusal: o guia premium para o cirurgião-dentista. Coleção Odontologia do Sono, Vol. II.">
<meta property="og:image" content="/images/ebook-bruxismo/mockup.webp">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,500;1,700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700;9..40,800&display=swap" rel="stylesheet">

<%- include('../partials/tracking') %>

<%
  const PRICE = '197';
  const PRICE_NUM = 197;
  const hasCheckout = Boolean(checkoutUrl);
  function cta(source, extra) {
    if (!hasCheckout) return '#comprar';
    const sep = checkoutUrl.includes('?') ? '&' : '?';
    return checkoutUrl + sep + 'checkoutMode=10' + (extra || '') + '&utm_source=landing&utm_medium=cta&utm_campaign=ebook_bruxismo&utm_content=' + source;
  }
  const ext = hasCheckout ? 'target="_blank" rel="noopener"' : '';
  const hasCoupon = hasCheckout && Boolean(coupon && coupon.code && coupon.price);
%>

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --navy: #07101e; --navy2: #0c1829; --navy3: #122238;
  --gold: #c9a84c; --gold2: #e3c77a; --gold3: #f3e2b3;
  --text: #c3d1df; --gray: #8b9cae; --white: #fff;
  --line: rgba(201,168,76,.18);
}
html { scroll-behavior: smooth; }
body { font-family: 'DM Sans', system-ui, sans-serif; color: var(--text); background: var(--navy); line-height: 1.6; overflow-x: hidden; }
img { max-width: 100%; height: auto; display: block; }
h1, h2, h3 { font-family: 'Playfair Display', Georgia, serif; color: #fff; line-height: 1.15; }
h2 { font-size: clamp(27px, 4vw, 40px); font-weight: 800; margin-bottom: 18px; }
h2 em, h1 em { color: var(--gold2); font-style: italic; font-weight: 500; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
.narrow { max-width: 780px; margin: 0 auto; }
.center { text-align: center; }
.tag { display: inline-block; color: var(--gold2); font-size: 12px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px; }
.lead { color: var(--gray); font-size: 17px; line-height: 1.75; }
section { padding: 88px 0; }

/* botões */
.btn { display: inline-block; background: linear-gradient(135deg, var(--gold) 0%, var(--gold2) 100%); color: var(--navy); font-weight: 800; font-size: 18px; padding: 18px 44px; border-radius: 50px; text-decoration: none; box-shadow: 0 10px 36px rgba(201,168,76,.32); transition: transform .15s, box-shadow .15s; text-align: center; }
.btn:hover { transform: translateY(-2px); box-shadow: 0 14px 44px rgba(201,168,76,.42); }
.btn-full { display: block; width: 100%; }
.micro { color: var(--gray); font-size: 13px; margin-top: 12px; }
.micro b { color: rgba(255,255,255,.8); }

/* topo */
.top-bar { background: linear-gradient(90deg, #0c1829, #122238); border-bottom: 1px solid var(--gold); color: #fff; text-align: center; padding: 9px 16px; font-size: 13px; font-weight: 700; }
.top-bar em { color: var(--gold2); font-style: normal; }
nav { background: rgba(7,16,30,.95); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 100; }
.nav-inner { max-width: 1100px; margin: 0 auto; padding: 13px 24px; display: flex; justify-content: space-between; align-items: center; }
.nav-logo { color: #fff; font-size: 15px; font-weight: 800; text-decoration: none; }
.nav-logo span { color: var(--gold2); }
.nav-cta { background: var(--gold); color: var(--navy); font-size: 13px; font-weight: 800; padding: 8px 22px; border-radius: 30px; text-decoration: none; }

/* hero */
.hero { padding: 72px 0 56px; background: radial-gradient(ellipse 60% 60% at 75% 45%, rgba(201,168,76,.10), transparent 70%), linear-gradient(135deg, var(--navy) 0%, var(--navy2) 70%); }
.hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center; }
.hero-tag { display: inline-flex; gap: 8px; align-items: center; background: rgba(201,168,76,.10); border: 1px solid rgba(201,168,76,.35); color: var(--gold2); font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; padding: 6px 16px; border-radius: 30px; margin-bottom: 22px; }
.hero h1 { font-size: clamp(32px, 4.8vw, 54px); font-weight: 800; margin-bottom: 18px; }
.hero-sub { font-size: clamp(16px, 2vw, 18px); color: var(--gray); line-height: 1.7; margin-bottom: 30px; max-width: 500px; }
.hero-price { color: #fff; font-size: 15px; font-weight: 700; margin-top: 14px; }
.hero-price strong { color: var(--gold2); font-size: 19px; }
.hero-img img { border-radius: 14px; box-shadow: 0 30px 80px rgba(0,0,0,.55); }

/* faixa de prova logo abaixo do hero */
.proof { background: var(--navy2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 26px 0; }
.proof-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.proof-item { text-align: center; }
.proof-item b { display: block; font-family: 'Playfair Display', serif; font-size: 34px; color: var(--gold2); line-height: 1; margin-bottom: 6px; }
.proof-item span { font-size: 13px; color: var(--gray); line-height: 1.4; display: block; }

/* problema */
.problema { background: var(--navy); padding-top: 72px; }
.prob-list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 30px; }
.prob-list li { background: rgba(255,255,255,.03); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px 18px 50px; position: relative; color: rgba(255,255,255,.88); font-size: 15px; }
.prob-list li::before { content: '!'; position: absolute; left: 18px; top: 17px; width: 22px; height: 22px; border-radius: 50%; background: rgba(201,168,76,.18); color: var(--gold2); font-weight: 800; font-size: 13px; display: flex; align-items: center; justify-content: center; }
.turn { margin-top: 30px; font-family: 'Playfair Display', serif; font-size: 22px; color: #fff; line-height: 1.4; }
.turn em { color: var(--gold2); }

/* para quem */
.paraquem { background: var(--navy2); }
.pq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 40px; }
.pq { background: rgba(255,255,255,.03); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
.pq h3 { font-family: 'DM Sans', sans-serif; font-size: 16px; font-weight: 800; color: #fff; margin-bottom: 6px; }
.pq p { font-size: 14px; color: var(--gray); }

/* mini oferta antecipada */
.mini { background: linear-gradient(135deg, rgba(201,168,76,.10), rgba(201,168,76,.03)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 56px 0; }
.mini-box { max-width: 860px; margin: 0 auto; display: grid; grid-template-columns: 210px 1fr; gap: 36px; align-items: center; }
.mini-box img { border-radius: 8px; box-shadow: 0 20px 50px rgba(0,0,0,.5); }
.mini-price { font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 800; color: #fff; line-height: 1; margin: 6px 0 4px; }
.mini-price small { font-size: 22px; color: var(--gold2); margin-right: 4px; }
.mini-list { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 12px 0 22px; font-size: 14px; color: rgba(255,255,255,.85); }
.mini-list li::before { content: '✓ '; color: var(--gold2); font-weight: 800; }

/* aprender */
.aprender { background: var(--navy); }
.ap-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-top: 40px; text-align: left; }
.ap { background: rgba(255,255,255,.03); border: 1px solid var(--line); border-radius: 14px; padding: 22px 20px; }
.ap .n { font-size: 11px; color: var(--gold2); font-weight: 800; letter-spacing: 1.4px; text-transform: uppercase; margin-bottom: 6px; }
.ap h3 { font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 700; color: #fff; line-height: 1.4; }

.gal { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 36px; }
.gal figure { margin: 0; position: relative; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); }
.gal img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
.gal figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 30px 16px 14px; background: linear-gradient(180deg, transparent, rgba(7,16,30,.92)); color: #fff; font-weight: 700; font-size: 14px; text-align: left; }
.gal figcaption span { display: block; color: var(--gold2); font-size: 11px; letter-spacing: 1.4px; text-transform: uppercase; margin-bottom: 2px; }
/* prévia */
.preview { background: var(--navy2); }
.pv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 40px; }
.pv-grid img { border-radius: 10px; box-shadow: 0 14px 40px rgba(0,0,0,.45); border: 1px solid rgba(255,255,255,.06); }
.pv-cap { margin-top: 18px; color: var(--gray); font-size: 14px; }

/* capítulos */
.capitulos { background: var(--navy); }
.cap-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; margin-top: 40px; text-align: left; }
.cap { display: flex; gap: 16px; align-items: flex-start; background: rgba(255,255,255,.03); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; }
.cap .n { font-family: 'Playfair Display', serif; font-style: italic; font-size: 22px; color: var(--gold2); width: 30px; flex-shrink: 0; line-height: 1.1; }
.cap h3 { font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 700; color: #fff; margin-bottom: 3px; }
.cap p { font-size: 13px; color: var(--gray); }

/* bônus */
.bonus { background: linear-gradient(180deg, var(--navy2), var(--navy)); border-top: 1px solid var(--line); }
.bonus-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: center; }
.bonus-grid img { border-radius: 14px; box-shadow: 0 24px 60px rgba(0,0,0,.5); }
.fichas { list-style: none; margin-top: 20px; }
.fichas li { padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.07); display: flex; gap: 14px; color: rgba(255,255,255,.88); font-size: 15px; }
.fichas li b { color: var(--gold2); font-family: 'Playfair Display', serif; font-size: 18px; width: 22px; flex-shrink: 0; }

/* oferta */
.oferta { background: var(--navy2); }
.of-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 56px; align-items: center; }
.of-box { background: rgba(255,255,255,.04); border: 1.5px solid rgba(201,168,76,.45); border-radius: 24px; padding: 40px 36px; }
.of-incl { list-style: none; margin: 18px 0 26px; }
.of-incl li { display: flex; gap: 10px; padding: 9px 0; border-bottom: 1px solid rgba(255,255,255,.06); font-size: 15px; color: rgba(255,255,255,.88); }
.of-incl li::before { content: '✓'; color: var(--gold2); font-weight: 800; }
.of-price { font-family: 'Playfair Display', serif; font-size: clamp(60px, 9vw, 80px); font-weight: 800; color: #fff; line-height: 1; }
.of-price small { font-size: 28px; color: var(--gold2); vertical-align: top; position: relative; top: 12px; margin-right: 6px; }
.of-note { color: var(--gray); font-size: 14px; margin: 6px 0 24px; }
.pending { margin-top: 14px; font-size: 13px; color: #f0a99f; text-align: center; font-weight: 700; }

/* garantia */
.garantia { background: var(--navy); }
.g-box { max-width: 820px; margin: 0 auto; display: flex; gap: 36px; align-items: center; border: 1px solid var(--line); border-radius: 22px; padding: 34px; }
.seal { width: 130px; height: 130px; border-radius: 50%; flex-shrink: 0; background: radial-gradient(circle at 35% 30%, #ecd28c, #c9a84c 60%, #9c7c2c); color: var(--navy); display: flex; flex-direction: column; align-items: center; justify-content: center; font-weight: 800; text-align: center; line-height: 1.05; }
.seal b { font-family: 'Playfair Display', serif; font-size: 48px; }
.seal small { font-size: 11px; letter-spacing: 1.4px; }

/* faq */
.faq { background: var(--navy2); }
.faq-item { background: rgba(255,255,255,.03); border: 1px solid var(--line); border-radius: 12px; margin-bottom: 10px; overflow: hidden; }
.faq-q { width: 100%; text-align: left; background: none; border: 0; font: inherit; padding: 19px 22px; font-weight: 700; color: #fff; font-size: 15.5px; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; }
.faq-q::after { content: '+'; color: var(--gold2); font-size: 22px; line-height: 1; }
.faq-item.open .faq-q::after { content: '−'; }
.faq-a { display: none; padding: 0 22px 20px; color: var(--gray); font-size: 14.5px; line-height: 1.8; }
.faq-item.open .faq-a { display: block; }

/* final */
.final { background: linear-gradient(180deg, rgba(7,16,30,.55), rgba(7,16,30,.92)), url('/images/ebook-bruxismo/foto-noite.webp') center/cover; text-align: center; padding: 120px 0; }
footer { background: #030a14; color: var(--gray); text-align: center; padding: 28px 20px; font-size: 13px; }
footer a { color: var(--gray); }
footer p { margin-bottom: 6px; }

.sticky { display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); background: rgba(7,16,30,.96); border-top: 1px solid var(--line); transform: translateY(110%); transition: transform .25s; }
.sticky.show { transform: none; }
.sticky a { display: block; text-align: center; background: linear-gradient(135deg, var(--gold), var(--gold2)); color: var(--navy); font-weight: 800; font-size: 16px; padding: 14px; border-radius: 50px; text-decoration: none; }

/* pop-up de saída (só intenção real) */
.exit-overlay { position: fixed; inset: 0; z-index: 1000; background: rgba(3,8,16,.82); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; padding: 20px; opacity: 0; transition: opacity .25s; }
.exit-overlay.open { display: flex; }
.exit-overlay.visible { opacity: 1; }
.exit-card { position: relative; width: 100%; max-width: 420px; background: linear-gradient(160deg, var(--navy2), var(--navy3)); border: 1px solid rgba(201,168,76,.45); border-radius: 22px; padding: 34px 26px 26px; text-align: center; box-shadow: 0 30px 80px rgba(0,0,0,.6); }
.exit-close { position: absolute; top: 10px; right: 12px; width: 40px; height: 40px; border: 0; background: transparent; color: var(--gray); font-size: 26px; cursor: pointer; }
.exit-title { font-family: 'Playfair Display', serif; color: #fff; font-size: 26px; font-weight: 800; line-height: 1.2; margin: 6px 0 8px; }
.exit-price { display: flex; align-items: baseline; justify-content: center; gap: 12px; margin: 14px 0 4px; }
.exit-price s { color: var(--gray); font-size: 20px; }
.exit-price strong { color: var(--gold2); font-size: 46px; font-family: 'Playfair Display', serif; line-height: 1; }
.exit-coupon { display: inline-block; border: 2px dashed rgba(201,168,76,.6); color: var(--gold2); font-weight: 800; letter-spacing: 2px; padding: 8px 18px; border-radius: 10px; margin: 12px 0 18px; }
.exit-dismiss { display: block; margin: 12px auto 0; background: none; border: 0; color: var(--gray); font-size: 13px; text-decoration: underline; cursor: pointer; }

@media (max-width: 860px) {
  section { padding: 60px 0; }
  .hero { padding: 26px 0 30px; }
  .hero-grid { grid-template-columns: 1fr; gap: 22px; }
  .hero-img { order: -1; max-width: 185px; margin: 0 auto; }
  .hero-grid { gap: 16px; }
  .hero-tag { margin-bottom: 14px; font-size: 10px; }
  .hero h1 { font-size: 31px; margin-bottom: 12px; }
  .hero-sub { font-size: 15.5px; margin-bottom: 18px; }
  .hero .btn { display: block; padding: 17px 20px; }
  .proof { padding: 20px 0; }
  .proof-grid { grid-template-columns: repeat(2, 1fr); gap: 16px 10px; }
  .proof-item b { font-size: 28px; }
  .problema { padding-top: 44px; }
  .prob-list { grid-template-columns: 1fr; }
  .mini-box { grid-template-columns: 1fr; text-align: center; gap: 20px; }
  .mini-box img { max-width: 150px; margin: 0 auto; }
  .mini-list { justify-content: center; }
  .pv-grid { grid-template-columns: 1fr 1fr; }
  .gal { grid-template-columns: 1fr; }
  .final { padding: 80px 0; }
  .bonus-grid, .of-grid { grid-template-columns: 1fr; gap: 30px; }
  .of-box { padding: 30px 22px; text-align: center; }
  .of-incl { text-align: left; }
  .g-box { flex-direction: column; text-align: center; padding: 26px; }
  .nav-cta { display: none; }
  .sticky { display: block; }
  body { padding-bottom: 76px; }
}
</style>
</head>
<body>

<div class="top-bar">🦷 <em>Coleção Odontologia do Sono</em> · Volume II · Acesso imediato + 6 fichas clínicas</div>

<nav>
  <div class="nav-inner">
    <a href="https://jaagendou.app" class="nav-logo">🦷 jaagendou<span>.app</span></a>
    <a href="<%= cta('nav_cta') %>" class="nav-cta" <%- ext %> data-checkout-source="nav_cta">Garantir acesso →</a>
  </div>
</nav>

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="hero-tag">◆ Protocolo clínico · Edição 2026</div>
      <h1>Bruxismo do sono: <em>do diagnóstico à placa</em>, com protocolo de consultório</h1>
